        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  A[\&quot;SRS LogiChain theo IEEE 830\&quot;] --&gt; B[\&quot;Bước 1: Xác định vị trí nội dung\&quot;]\n  A --&gt; C[\&quot;Bước 2: Chuẩn hóa yêu cầu Verifiable\&quot;]\n\n  subgraph IEEE830[\&quot;Cấu trúc IEEE 830\&quot;]\n    D[\&quot;Chương 1: Giới thiệu\&quot;]\n    E[\&quot;Chương 2: Mô tả tổng quan\&quot;]\n    F[\&quot;Chương 3: Yêu cầu cụ thể\&quot;]\n  end\n\n  B --&gt; G[\&quot;Mục A: Định nghĩa SKU\&quot;]\n  G --&gt; G1[\&quot;Vị trí bản thảo: 2.4 Constraints\&quot;]\n  G1 --&gt; G2[\&quot;Sai\&quot;]\n  G2 --&gt; G3[\&quot;Vị trí đúng: 1.2 Định nghĩa, thuật ngữ và từ viết tắt\&quot;]\n\n  B --&gt; H[\&quot;Mục B: REQ-01, REQ-02, REQ-03\&quot;]\n  H --&gt; H1[\&quot;Vị trí: 3.2 Functional Requirements\&quot;]\n  H1 --&gt; H2[\&quot;Đúng\&quot;]\n\n  B --&gt; I[\&quot;Danh sách Actor và Use Case tổng thể\&quot;]\n  I --&gt; I1[\&quot;Vị trí: 2.3 User Characteristics hoặc 3.1 External Interfaces\&quot;]\n  I1 --&gt; I2[\&quot;Đề xuất: 2.3 User Characteristics\&quot;]\n  I2 --&gt; I3[\&quot;Actor: Nhân viên kho\&quot;]\n  I2 --&gt; I4[\&quot;Actor: Quản lý kho\&quot;]\n  I3 --&gt; I5[\&quot;Use Case: Quét mã vạch nhập/xuất kho\&quot;]\n  I3 --&gt; I6[\&quot;Use Case: Tra cứu tồn kho\&quot;]\n  I4 --&gt; I7[\&quot;Use Case: Xuất báo cáo tồn kho\&quot;]\n\n  B --&gt; J[\&quot;Sequence Diagram minh họa REQ-02\&quot;]\n  J --&gt; J1[\&quot;Vị trí: 3.2 Functional Requirements\&quot;]\n  J1 --&gt; J2[\&quot;Đặt ngay dưới REQ-02 để minh họa luồng xử lý\&quot;]\n\n  C --&gt; K[\&quot;REQ-02\&quot;]\n  K --&gt; K1[\&quot;Yêu cầu chuẩn hóa\&quot;]\n  K1 --&gt; K2[\&quot;Sau khi nhân viên kho quét mã vạch hợp lệ, hệ thống phải hiển thị kết quả xác nhận và cập nhật trạng thái xử lý trong tối đa 2 giây đối với ít nhất 95% giao dịch, đo từ thời điểm hệ thống nhận đủ dữ liệu mã vạch.\&quot;]\n\n  C --&gt; L[\&quot;REQ-03\&quot;]\n  L --&gt; L1[\&quot;Yêu cầu chuẩn hóa\&quot;]\n  L1 --&gt; L2[\&quot;Hệ thống phải cho phép người dùng có vai trò Quản lý kho xuất báo cáo tồn kho theo bộ lọc đã chọn; khi người dùng nhấn nút Xuất báo cáo, hệ thống phải tạo tệp báo cáo trong tối đa 10 giây đối với báo cáo không quá 10000 dòng.\&quot;]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BQ-GVASxJTH0WlD0-mKW-1">
